+static void draw_subdiv_compile_requested_shaders(const Mesh &mesh,
+                                                  const int material_count,
+                                                  const bool use_loop_normals,
+                                                  const MeshBufferCache &mbc,
+                                                  const Span<IBOType> ibo_requests,
+                                                  const Span<VBOType> vbo_requests)
+{
+  static const bool serial = std::getenv("BLENDER_RUST_SUBDIV_SERIAL_DRAW_SHADERS") != nullptr;
+  if (serial || GPU_backend_get_type() != GPU_BACKEND_VULKAN || mesh.faces_num == 0) {
+    return;
+  }
+
+  const auto needs_vbo = [&](const VBOType type) {
+    return vbo_requests.contains(type) && !mbc.buff.vbos.contains(type);
+  };
+  if (const bool orco = needs_vbo(VBOType::Orco); orco || needs_vbo(VBOType::Position)) {
+    DRW_shader_subdiv_compile_async(orco ? SubdivShaderType::PATCH_EVALUATION_ORCO :
+                                         SubdivShaderType::PATCH_EVALUATION);
+  }
+  if (needs_vbo(VBOType::CornerNormal) &&
+      !(use_loop_normals && mesh.attributes().contains("custom_normal")))
+  {
+    DRW_shader_subdiv_compile_async(SubdivShaderType::BUFFER_NORMALS_ACCUMULATE);
+    DRW_shader_subdiv_compile_async(SubdivShaderType::BUFFER_LNOR);
+  }
+  if (ibo_requests.contains(IBOType::Tris) && !mbc.buff.ibos.contains(IBOType::Tris)) {
+    DRW_shader_subdiv_compile_async(material_count <= 1 ? SubdivShaderType::BUFFER_TRIS :
+                                                         SubdivShaderType::BUFFER_TRIS_MULTIPLE_MATERIALS);
+  }
+}
