+/**
+ * Filter the side of d against the oriented plane abc. A zero result means that
+ * the floating determinant could not certify the sign.
+ */
+static inline int tti_filtered_above(const double3 &a,
+                                     const double3 &b,
+                                     const double3 &c,
+                                     const double3 &d)
+{
+  const double determinant = math::dot(d - a, math::cross(b - a, c - a));
+  if (determinant == 0.0) {
+    return 0;
+  }
+
+  const double3 abs_a = math::abs(a);
+  const double3 ba_bound = math::abs(b) + abs_a;
+  const double3 ca_bound = math::abs(c) + abs_a;
+  const double3 da_bound = math::abs(d) + abs_a;
+  if (!(math::reduce_max(math::max(ba_bound, math::max(ca_bound, da_bound))) <= 0x1p100)) {
+    return 0;
+  }
+
+  const double3 cross_bound(ba_bound.y * ca_bound.z + ba_bound.z * ca_bound.y,
+                            ba_bound.z * ca_bound.x + ba_bound.x * ca_bound.z,
+                            ba_bound.x * ca_bound.y + ba_bound.y * ca_bound.x);
+  const double supremum = math::dot(da_bound, cross_bound);
+  /* Bound the six degree-three monomials before cancellation. The multiplier
+   * covers truncating each exact coordinate to double, the difference/product/
+   * sum operations, and rounding of this bound. The absolute floor covers
+   * subnormal arithmetic with the coordinate range bounded above. */
+  const double error = 64.0 * DBL_EPSILON * supremum + 0x1p-500;
+  if (std::abs(determinant) > error) {
+    return determinant > 0.0 ? 1 : -1;
+  }
+  return 0;
 }
 
