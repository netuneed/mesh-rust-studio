+static uint64_t hash_vert_coordinates(const double3 &co)
+{
+  uint64_t x = std::bit_cast<uint64_t>(co.x);
+  uint64_t y = std::bit_cast<uint64_t>(co.y);
+  uint64_t z = std::bit_cast<uint64_t>(co.z);
   x = (x >> 56) ^ (x >> 46) ^ x;
   y = (y >> 55) ^ (y >> 45) ^ y;
   z = (z >> 54) ^ (z >> 44) ^ z;
   return x ^ y ^ z;
+}
+
+uint64_t Vert::hash() const
+{
+  return hash_vert_coordinates(this->co);
 }
 
