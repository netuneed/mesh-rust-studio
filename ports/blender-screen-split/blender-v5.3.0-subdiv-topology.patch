+#ifdef WITH_BLENDER_RUST_SUBDIV_EDGES
+/* The two output spans are disjoint and owned by this coarse face's task. */
+extern "C" bool blender_rust_subdiv_inner_loops(int *corner_vertices,
+                                                int *corner_edges,
+                                                size_t quad_count,
+                                                int width,
+                                                int first_vertex,
+                                                int first_edge);
+
+static void subdiv_mesh_uv_inner_grid(SubdivMeshContext &ctx,
+                                      const int first_loop,
+                                      const int width,
+                                      const int ptex_face_index,
+                                      const float step)
+{
+  Array<float2> previous(width), next(width);
+  const auto evaluate_row = [&](const int channel, const int y, MutableSpan<float2> row) {
+    for (const int x : row.index_range()) {
+      eval_face_varying(
+          ctx.subdiv, channel, ptex_face_index, float(x + 1) * step, float(y + 1) * step, row[x]);
+    }
+  };
+  for (const int channel : ctx.uv_maps.index_range()) {
+    MutableSpan<float2> output = ctx.uv_maps[channel].span;
+    int corner = first_loop;
+    evaluate_row(channel, 0, previous);
+    for (int y = 1; y < width; y++) {
+      evaluate_row(channel, y, next);
+      for (int x = 0; x < width - 1; x++) {
+        output[corner++] = previous[x];
+        output[corner++] = previous[x + 1];
+        output[corner++] = next[x + 1];
+        output[corner++] = next[x];
+      }
+      std::swap(previous, next);
+    }
+  }
+}
+
+static bool subdiv_mesh_regular_inner_loops(const ForeachContext *foreach_context,
+                                            const int first_loop,
+                                            const int first_vertex,
+                                            const int first_edge,
+                                            const int width,
+                                            const int ptex_face_index,
+                                            const float step)
+{
+  SubdivMeshContext &ctx = *static_cast<SubdivMeshContext *>(foreach_context->user_data);
+  /* The per-loop path is needed for general attributes and custom normals. UVs are evaluated
+   * separately using the original immutable OpenSubdiv evaluator. */
+  if (width < 2 || width > 32768 || first_loop < 0 || first_vertex < 0 || first_edge < 0 ||
+      !ctx.coarse_corner_attr_spans.is_empty() || !ctx.coarse_CD_NORMAL.is_empty() ||
+      !ctx.coarse_CD_ORIGSPACE_MLOOP.is_empty())
+  {
+    return false;
+  }
+  const int64_t quad_count = int64_t(width - 1) * (width - 1);
+  const int64_t corner_count = 4 * quad_count;
+  if (corner_count > ctx.subdiv_corner_verts.size() - first_loop ||
+      corner_count > ctx.subdiv_corner_edges.size() - first_loop ||
+      int64_t(width) * width > ctx.subdiv_positions.size() - first_vertex ||
+      2 * int64_t(width) * (width - 1) > ctx.subdiv_edges.size() - first_edge)
+  {
+    return false;
+  }
+  for (const auto &uv_map : ctx.uv_maps) {
+    if (corner_count > uv_map.span.size() - first_loop) {
+      return false;
+    }
+  }
+  MutableSpan<int> vertices = ctx.subdiv_corner_verts.slice(first_loop, corner_count);
+  MutableSpan<int> edges = ctx.subdiv_corner_edges.slice(first_loop, corner_count);
+  if (!blender_rust_subdiv_inner_loops(
+          vertices.data(), edges.data(), quad_count, width, first_vertex, first_edge))
+  {
+    return false;
+  }
+
+  int64_t uv_evaluations = 0;
+  if (!ctx.uv_maps.is_empty()) {
+    static const bool reference_uv = std::getenv("BLENDER_RUST_SUBDIV_UV_REFERENCE") != nullptr;
+    /* For bounded dyadic grids, x*step and (x-1)*step+step are bit-identical. Neighboring faces
+     * may share these samples inside this PTEX face. Never reuse across PTEX/UV boundaries. */
+    const bool exact_grid = std::has_single_bit(unsigned(width + 1)) &&
+                            step == 1.0f / float(width + 1);
+    if (!reference_uv && exact_grid) {
+      subdiv_mesh_uv_inner_grid(ctx, first_loop, width, ptex_face_index, step);
+      uv_evaluations = int64_t(width) * width * ctx.uv_maps.size();
+    }
+    else {
+      int i = first_loop;
+      for (int y = 1; y < width; y++) {
+        const float v = y * step;
+        for (int x = 1; x < width; x++) {
+          const float u = x * step;
+          subdiv_eval_uv_layer(&ctx, i++, ptex_face_index, u, v);
+          subdiv_eval_uv_layer(&ctx, i++, ptex_face_index, u + step, v);
+          subdiv_eval_uv_layer(&ctx, i++, ptex_face_index, u + step, v + step);
+          subdiv_eval_uv_layer(&ctx, i++, ptex_face_index, u, v + step);
+        }
+      }
+      uv_evaluations = corner_count * ctx.uv_maps.size();
+    }
+  }
+  if (subdiv_mesh_topology_trace()) {
+    std::fprintf(stderr,
+                 "RUST_SUBDIV_INNER_LOOPS count=%lld width=%d uv_evaluations=%lld\n",
+                 static_cast<long long>(corner_count),
+                 width,
+                 static_cast<long long>(uv_evaluations));
+  }
+  return true;
+}
+#endif
