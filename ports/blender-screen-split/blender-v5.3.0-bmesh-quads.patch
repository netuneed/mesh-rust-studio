+/* SPDX-FileCopyrightText: 2008 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+namespace blender {
+struct BLI_mempool;
+
+/** Allocate elements in the same order as repeated BLI_mempool_alloc calls. */
+void BLI_mempool_alloc_batch(BLI_mempool *pool, void **elements, unsigned int count);
+}  // namespace blender
diff --git a/source/blender/blenlib/intern/BLI_mempool.cc b/source/blender/blenlib/intern/BLI_mempool.cc
--- a/source/blender/blenlib/intern/BLI_mempool.cc
+++ b/source/blender/blenlib/intern/BLI_mempool.cc
@@ -26,6 +26,7 @@
 #include "BLI_math_base_c.hh"
 #include "BLI_mempool.hh"         /* own include */
 #include "BLI_mempool_bulk_init.hh"
+#include "BLI_mempool_batch.hh"
 #include "BLI_mempool_private.h" /* own include */

 #if defined(WITH_BLENDER_RUST_BMESH_POOL) && !defined(WITH_ASAN) && !defined(WITH_MEM_VALGRIND)
@@ -543,6 +544,31 @@
 #endif

   return static_cast<void *>(free_pop);
+}
+
+void BLI_mempool_alloc_batch(BLI_mempool *pool, void **elements, const uint count)
+{
+#if defined(WITH_ASAN) || defined(WITH_MEM_VALGRIND) || !defined(NDEBUG)
+  for (uint i = 0; i < count; i++) {
+    elements[i] = BLI_mempool_alloc(pool);
+  }
+#else
+  BLI_freenode *free_node = pool->free;
+  for (uint i = 0; i < count; i++) {
+    if (!free_node) [[unlikely]] {
+      pool->free = nullptr;
+      mempool_chunk_add(pool, mempool_chunk_alloc(pool), nullptr);
+      free_node = pool->free;
+    }
+    elements[i] = free_node;
+    if (pool->flag & BLI_MEMPOOL_ALLOW_ITER) {
+      free_node->freeword = USEDWORD;
+    }
+    free_node = free_node->next;
+  }
+  pool->free = free_node;
+  pool->totused += count;
+#endif
 }

 void *BLI_mempool_calloc(BLI_mempool *pool)
