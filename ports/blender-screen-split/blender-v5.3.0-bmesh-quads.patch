+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include "BLI_span.hh"
+
+namespace blender {
+struct BMesh;
+struct BMVert;
+struct BMEdge;
+struct BMFace;
+
+#if defined(WITH_BLENDER_RUST_BMESH_QUADS) && defined(NDEBUG) && !defined(WITH_ASAN) && \
+    !defined(WITH_MEM_VALGRIND) && !defined(USE_BMESH_HOLES)
+#  define BMESH_RUST_QUAD_BATCH
+
+constexpr int bm_rust_quad_batch_size = 128;
+
+struct BMeshQuadInput {
+  BMVert *verts[4];
+  BMEdge *edges[4];
+};
+
+/** Allocate faces and loops, then connect the quad and radial cycles in insertion order. */
+void BM_mesh_convert_quad_batch(BMesh &bm,
+                                Span<BMeshQuadInput> input,
+                                MutableSpan<BMFace *> result,
+                                int first_loop_index);
+#endif
+}  // namespace blender
