 }
+
+#ifdef BMESH_RUST_QUAD_BATCH
+/* Shared with bmesh_quads.rs. No allocator or BMesh ownership enters Rust. */
+static_assert(sizeof(void *) == 8);
+static_assert(sizeof(BMHeader) == 16 && alignof(BMHeader) == 8);
+static_assert(offsetof(BMHeader, data) == 0 && offsetof(BMHeader, index) == 8);
+static_assert(offsetof(BMHeader, htype) == 12 && offsetof(BMHeader, hflag) == 13 &&
+              offsetof(BMHeader, api_flag) == 14);
+static_assert(sizeof(BMLoop) == 72 && alignof(BMLoop) == 8);
+static_assert(offsetof(BMLoop, head) == 0 && offsetof(BMLoop, v) == 16 &&
+              offsetof(BMLoop, e) == 24 && offsetof(BMLoop, f) == 32);
+static_assert(offsetof(BMLoop, radial_next) == 40 && offsetof(BMLoop, radial_prev) == 48 &&
+              offsetof(BMLoop, next) == 56 && offsetof(BMLoop, prev) == 64);
+static_assert(sizeof(BMEdge) == 72 && alignof(BMEdge) == 8 && offsetof(BMEdge, l) == 32);
+static_assert(sizeof(BMeshQuadInput) == 64 && alignof(BMeshQuadInput) == 8);
+static_assert(offsetof(BMeshQuadInput, verts) == 0 && offsetof(BMeshQuadInput, edges) == 32);
+static_assert(BM_LOOP == 4);
+
+extern "C" uint8_t blender_rust_bmesh_quad_batch(const BMeshQuadInput *input,
+                                              void *const *faces,
+                                              void *const *loops,
+                                              unsigned int count,
+                                              int first_loop_index);
+
+void BM_mesh_convert_quad_batch(BMesh &bm,
+                                const Span<BMeshQuadInput> input,
+                                const MutableSpan<BMFace *> result,
+                                const int first_loop_index)
+{
+  constexpr int capacity = bm_rust_quad_batch_size;
+  BLI_assert(input.size() > 0 && input.size() <= capacity && result.size() == input.size());
+  const int count = int(input.size());
+  void *faces[capacity];
+  void *loops[capacity * 4];
+  BLI_mempool_alloc_batch(bm.fpool, faces, uint(count));
+  BLI_mempool_alloc_batch(bm.lpool, loops, uint(count * 4));
+  for (int i = 0; i < count; i++) {
+    BMFace *face = static_cast<BMFace *>(faces[i]);
+    bm_face_init(&bm, face);
+    BM_elem_index_set(face, bm.totface + i); /* set_ok */
+    face->len = 4;
+    face->l_first = static_cast<BMLoop *>(loops[i * 4]);
+    zero_v3(face->no);
+    result[i] = face;
+  }
+  if (!blender_rust_bmesh_quad_batch(input.data(), faces, loops, uint(count), first_loop_index)) {
+    /* Rust rejects before changing any element. The pool allocations remain valid. */
+    for (int i = 0; i < count; i++) {
+      BMFace *face = result[i];
+      for (int j = 0; j < 4; j++) {
+        BMLoop *loop = static_cast<BMLoop *>(loops[i * 4 + j]);
+        loop->head = {nullptr, first_loop_index + i * 4 + j, BM_LOOP, 0, 0};
+        loop->v = input[i].verts[j];
+        loop->f = face;
+        loop->e = input[i].edges[j];
+        loop->next = static_cast<BMLoop *>(loops[i * 4 + ((j + 1) % 4)]);
+        loop->prev = static_cast<BMLoop *>(loops[i * 4 + ((j + 3) % 4)]);
+        bmesh_radial_loop_append(input[i].edges[j], loop);
+      }
+    }
+  }
+  bm.totface += count;
+  bm.totloop += count * 4;
+  bm.elem_index_dirty |= BM_FACE | BM_LOOP;
+  bm.elem_table_dirty |= BM_FACE;
+  bm.spacearr_dirty |= BM_SPACEARR_DIRTY_ALL;
+}
+#endif

