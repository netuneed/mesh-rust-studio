+#ifdef BMESH_RUST_QUAD_BATCH
+static bool bm_quad_input(const IndexRange face,
+                          const Span<int> corner_verts,
+                          const Span<int> corner_edges,
+                          const Span<BMVert *> vtable,
+                          const Span<BMEdge *> etable,
+                          BMeshQuadInput &input)
+{
+  if (face.size() != 4 || face.start() < 0 || face.one_after_last() > corner_verts.size() ||
+      face.one_after_last() > corner_edges.size())
+  {
+    return false;
+  }
+  for (int j = 0; j < 4; j++) {
+    const int vi = corner_verts[face.start() + j];
+    const int ei = corner_edges[face.start() + j];
+    if (vi < 0 || vi >= vtable.size() || ei < 0 || ei >= etable.size()) {
+      return false;
+    }
+    input.verts[j] = vtable[vi];
+    input.edges[j] = etable[ei];
+  }
+  for (int j = 0; j < 4; j++) {
+    const BMVert *v = input.verts[j];
+    const BMVert *next = input.verts[(j + 1) % 4];
+    const BMEdge *e = input.edges[j];
+    if (!v || !e || ELEM(v, input.verts[(j + 1) % 4], input.verts[(j + 2) % 4]) ||
+        ELEM(e, input.edges[(j + 1) % 4], input.edges[(j + 2) % 4]) ||
+        !((e->v1 == v && e->v2 == next) || (e->v1 == next && e->v2 == v)))
+    {
+      return false;
+    }
+  }
+  return true;
+}
+#endif

