+#ifdef WITH_BLENDER_RUST_SCREEN_SPLIT
+/* Keep these value types in sync with ports/blender-screen-split/split.rs. */
+struct RustSplitPoint {
+  int16_t x, y;
+};
+
+struct RustSplitCorners {
+  RustSplitPoint points[4];
+};
+
+struct RustSplitPlan {
+  RustSplitPoint points[2];
+  uint8_t edges[5][2];
+  uint8_t original_corners[4];
+  uint8_t new_corners[4];
+  uint8_t original_side;
+  uint8_t valid;
+};
+
+static_assert(sizeof(float) == 4 && alignof(float) == 4);
+static_assert(sizeof(RustSplitPoint) == 4 && alignof(RustSplitPoint) == 2);
+static_assert(offsetof(RustSplitPoint, x) == 0 && offsetof(RustSplitPoint, y) == 2);
+static_assert(sizeof(RustSplitCorners) == 16 && alignof(RustSplitCorners) == 2);
+static_assert(offsetof(RustSplitCorners, points) == 0);
+static_assert(sizeof(RustSplitPlan) == 28 && alignof(RustSplitPlan) == 2);
+static_assert(offsetof(RustSplitPlan, points) == 0);
+static_assert(offsetof(RustSplitPlan, edges) == 8);
+static_assert(offsetof(RustSplitPlan, original_corners) == 18);
+static_assert(offsetof(RustSplitPlan, new_corners) == 22);
+static_assert(offsetof(RustSplitPlan, original_side) == 26);
+static_assert(offsetof(RustSplitPlan, valid) == 27);
+
+extern "C" RustSplitPlan blender_screen_split_plan(RustSplitCorners corners,
+                                                   uint8_t axis,
+                                                   int16_t split,
+                                                   float fac);
+
+static bool rust_split_plan_valid(const RustSplitPlan &plan)
+{
+  if (plan.valid != 1 || plan.original_side > 1) {
+    return false;
+  }
+  for (const auto &edge : plan.edges) {
+    if (edge[0] >= 6 || edge[1] >= 6) {
+      return false;
+    }
+  }
+  for (int corner = 0; corner < 4; corner++) {
+    if (plan.original_corners[corner] >= 6 || plan.new_corners[corner] >= 6) {
+      return false;
+    }
+  }
+  return true;
+}
+#endif
