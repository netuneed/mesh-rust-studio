diff --git a/source/blender/nodes/intern/dependencies.cc b/source/blender/nodes/intern/dependencies.cc
index 95386708..0815ae9c 100644
--- a/source/blender/nodes/intern/dependencies.cc
+++ b/source/blender/nodes/intern/dependencies.cc
@@ -260,12 +260,38 @@ static bool needs_scene_render_params(const bNodeTree &ntree)
   return false;
 }

+static void gather_unlinked_modifier_id_inputs(const bNodeTree &ntree, EvalDependencies &deps)
+{
+  ntree.ensure_interface_cache();
+  for (const bNodeTreeInterfaceSocket *input : ntree.interface_inputs()) {
+    const bke::bNodeSocketType *type = input->socket_typeinfo();
+    if (type && (type->type == SOCK_OBJECT || type->type == SOCK_COLLECTION)) {
+      deps.unlinked_modifier_id_inputs.add(input->identifier);
+    }
+  }
+  if (deps.unlinked_modifier_id_inputs.is_empty()) {
+    return;
+  }
+  /* Keep every direct link, including links used by viewers, baking and dynamic branches. */
+  for (const bNode *node : ntree.group_input_nodes()) {
+    for (const bNodeSocket *output : node->output_sockets()) {
+      if (output->is_directly_linked()) {
+        deps.unlinked_modifier_id_inputs.remove(output->identifier);
+      }
+    }
+  }
+}
+
 static void gather_geometry_nodes_eval_dependencies(
     const bNodeTree &ntree,
     EvalDependencies &deps,
     FunctionRef<const EvalDependencies *(const bNodeTree &group)> get_group_deps)
 {
   ntree.ensure_topology_cache();
+  if (ntree.type == NTREE_GEOMETRY) {
+    /* Include connectivity in the cached dependencies so relinking rebuilds relations. */
+    gather_unlinked_modifier_id_inputs(ntree, deps);
+  }
   for (const bNodeSocket *socket : ntree.all_sockets()) {
     add_eval_dependencies_from_socket(*socket, deps);
   }
