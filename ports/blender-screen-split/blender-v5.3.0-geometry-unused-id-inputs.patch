diff --git a/source/blender/modifiers/intern/MOD_nodes.cc b/source/blender/modifiers/intern/MOD_nodes.cc
index 10d35e49..e1f897a6 100644
--- a/source/blender/modifiers/intern/MOD_nodes.cc
+++ b/source/blender/modifiers/intern/MOD_nodes.cc
@@ -112,10 +112,22 @@ static void init_data(ModifierData *md)
 static void find_dependencies_from_settings(const NodesModifierData &nmd,
                                             nodes::EvalDependencies &deps)
 {
+  Set<const IDProperty *> unused_values;
+  const IDProperty *inputs = IDP_GetPropertyFromGroup_null(nmd.modifier.system_properties, "inputs");
+  if (inputs && inputs->type == IDP_GROUP) {
+    for (const std::string &identifier : deps.unlinked_modifier_id_inputs) {
+      const IDProperty *input = IDP_GetPropertyTypeFromGroup(inputs, identifier, IDP_GROUP);
+      if (input) {
+        if (const IDProperty *value = IDP_GetPropertyTypeFromGroup(input, "value", IDP_ID)) {
+          unused_values.add(value);
+        }
+      }
+    }
+  }
   IDP_foreach_property(
       nmd.modifier.system_properties, IDP_TYPE_FILTER_ID, [&](IDProperty *property) {
-        if (ID *id = IDP_ID_get(property)) {
-          deps.add_generic_id_full(id);
+        if (!unused_values.contains(property)) {
+          deps.add_generic_id_full(IDP_ID_get(property));
         }
       });
 }
