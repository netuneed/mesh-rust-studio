 GPUPatchTable::~GPUPatchTable()
 {
+  discard_buffer(&_patchArrayBuffer);
   discard_buffer(&_patchIndexBuffer);
   discard_buffer(&_patchParamBuffer);
   discard_buffer(&_varyingIndexBuffer);
+  discard_list(_fvarPatchArrayBuffers);
   discard_list(_fvarIndexBuffers);
   discard_list(_fvarParamBuffers);
+}
+
+static gpu::StorageBuf *ensure_patch_array_buffer(gpu::StorageBuf *&buffer,
+                                                  const PatchArrayVector &arrays)
+{
+  if (buffer == nullptr) {
+    const auto begin = subdivision_profile::start();
+    buffer = GPU_storagebuf_create_ex(
+        arrays.size() * sizeof(PatchArray), arrays.data(), GPU_USAGE_STATIC, "osd_patch_array");
+    subdivision_profile::report("osd_gpu_patch_array_create", begin);
+  }
+  return buffer;
+}
+
+gpu::StorageBuf *GPUPatchTable::GetPatchArrayBuffer()
+{
+  return ensure_patch_array_buffer(_patchArrayBuffer, _patchArrays);
+}
+
+gpu::StorageBuf *GPUPatchTable::GetFVarPatchArrayBuffer(const int fvarChannel)
+{
+  return ensure_patch_array_buffer(_fvarPatchArrayBuffers[fvarChannel],
+                                   _fvarPatchArrays[fvarChannel]);
 }

