+#ifdef WITH_BLENDER_RUST_SUBDIV_EDGES
+static_assert(sizeof(int2) == 8 && alignof(int2) == 4 && sizeof(int) == 4);
+
+/* The edge slice is exclusively owned by this face's traversal task. */
+extern "C" bool blender_rust_subdiv_inner_edges(void *output,
+                                                 size_t count,
+                                                 int width,
+                                                 int first_vertex);
+
+static bool subdiv_mesh_regular_inner_edges(const ForeachContext *foreach_context,
+                                             const int first_edge,
+                                             const int first_vertex,
+                                             const int width)
+{
+  SubdivMeshContext *ctx = static_cast<SubdivMeshContext *>(foreach_context->user_data);
+  /* Edge-domain attributes need the original per-edge default initialization. */
+  if (!ctx->coarse_edge_attrs.is_empty() || width < 2 || first_edge < 0 ||
+      first_vertex < 0)
+  {
+    return false;
+  }
+  const int64_t edge_count = 2 * int64_t(width) * (width - 1);
+  if (edge_count > ctx->subdiv_edges.size() - first_edge ||
+      int64_t(width) * width > ctx->subdiv_positions.size() - first_vertex)
+  {
+    return false;
+  }
+  MutableSpan<int2> output = ctx->subdiv_edges.slice(first_edge, edge_count);
+  if (!blender_rust_subdiv_inner_edges(output.data(), output.size(), width, first_vertex)) {
+    return false;
+  }
+  if (!ctx->subdiv_edge_origindex.is_empty()) {
+    ctx->subdiv_edge_origindex.slice(first_edge, edge_count).fill(ORIGINDEX_NONE);
+  }
+  /* Optimal display uses false for these edges, as already initialized. */
+  static const bool trace = std::getenv("BLENDER_RUST_SUBDIV_TRACE") != nullptr;
+  if (trace) {
+    std::fprintf(stderr, "RUST_SUBDIV_INNER_EDGES count=%lld width=%d\n",
+                 static_cast<long long>(edge_count), width);
+  }
+  return true;
+}
+#endif
