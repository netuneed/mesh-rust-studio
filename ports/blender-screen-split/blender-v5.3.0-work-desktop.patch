 void GHOST_WindowWin32::registerWindowAppUserModelProperties()
 {
+  wchar_t port_instance[8] = {};
+  const DWORD instance_length = GetEnvironmentVariableW(
+      L"BLENDER_RUST_PORT_INSTANCE", port_instance, ARRAYSIZE(port_instance));
+  if (instance_length == 4 &&
+      lstrcmpW(port_instance, L"work") == 0)
+  {
+    wchar_t executable[MAX_PATH] = {};
+    const DWORD length = GetModuleFileNameW(nullptr, executable, ARRAYSIZE(executable));
+    const wchar_t *name = wcsrchr(executable, L'\\');
+    std::wstring launcher;
+    if (length != 0 && length < ARRAYSIZE(executable) && name) {
+      launcher.assign(executable, size_t(name + 1 - executable));
+      launcher += L"Blender+ RUST.exe";
+    }
+
+    IPropertyStore *properties;
+    if (SUCCEEDED(SHGetPropertyStoreForWindow(h_wnd_, IID_PPV_ARGS(&properties)))) {
+      const auto set_string = [&](const PROPERTYKEY &key, const wchar_t *text) {
+        PROPVARIANT value;
+        if (SUCCEEDED(InitPropVariantFromString(text, &value))) {
+          properties->SetValue(key, value);
+          PropVariantClear(&value);
+        }
+      };
+      if (!launcher.empty()) {
+        const std::wstring command = L"\"" + launcher + L"\"";
+        const std::wstring icon = launcher + L",0";
+        set_string(PKEY_AppUserModel_RelaunchCommand, command.c_str());
+        set_string(PKEY_AppUserModel_RelaunchDisplayNameResource, L"Blender+ RUST");
+        set_string(PKEY_AppUserModel_RelaunchIconResource, icon.c_str());
+      }
+      set_string(PKEY_AppUserModel_ID, L"BlenderFoundation.BlenderRust.Work.5.3");
+      properties->Release();
+    }
+
+    struct LauncherIcons {
+      HICON large_icon = nullptr;
+      HICON small_icon = nullptr;
+
+      explicit LauncherIcons(const std::wstring &path)
+      {
+        if (!path.empty()) {
+          ExtractIconExW(path.c_str(), 0, &large_icon, &small_icon, 1);
+        }
+      }
+
+      ~LauncherIcons()
+      {
+        if (large_icon) {
+          DestroyIcon(large_icon);
+        }
+        if (small_icon) {
+          DestroyIcon(small_icon);
+        }
+      }
+    };
+    static const LauncherIcons icons(launcher);
+    if (icons.large_icon) {
+      SendMessageW(h_wnd_, WM_SETICON, ICON_BIG, LPARAM(icons.large_icon));
+    }
+    if (icons.small_icon) {
+      SendMessageW(h_wnd_, WM_SETICON, ICON_SMALL, LPARAM(icons.small_icon));
+    }
+    return;
+  }
+
