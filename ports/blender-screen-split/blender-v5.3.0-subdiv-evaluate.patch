@@ -1136,4 +1136,43 @@ static void subdiv_mesh_vert_inner(const ForeachContext *foreach_context,
 }

+static bool subdiv_mesh_regular_inner_positions(const ForeachContext *foreach_context,
+                                                void *tls_v,
+                                                const int ptex_face_index,
+                                                const int coarse_face_index,
+                                                const int first_vertex,
+                                                const int resolution)
+{
+  SubdivMeshContext *ctx = static_cast<SubdivMeshContext *>(foreach_context->user_data);
+  SubdivMeshTLS *tls = static_cast<SubdivMeshTLS *>(tls_v);
+  const int width = resolution - 2;
+  if (width < 2 || ctx->subdiv->displacement_evaluator) {
+    return false;
+  }
+  const float step = 1.0f / float(resolution - 1);
+  const bool vertex_data = !ctx->coarse_vert_attrs.is_empty() ||
+                           !ctx->coarse_vert_origindex.is_empty() ||
+                           !ctx->coarse_dverts.is_empty();
+  if (vertex_data) {
+    subdiv_mesh_ensure_vert_interpolation(ctx, tls, coarse_face_index, 0);
+  }
+  const IndexRange coarse_face = ctx->coarse_faces[coarse_face_index];
+  for (int y = 1; y <= width; y++) {
+    const float v = y * step;
+    const int row = first_vertex + (y - 1) * width;
+    eval_limit_grid_row(
+        ctx->subdiv, ptex_face_index, 1, step, v, ctx->subdiv_positions.slice(row, width));
+    for (int x = 1; x <= width; x++) {
+      const float u = x * step;
+      const int vertex = row + x - 1;
+      if (vertex_data) {
+        subdiv_vert_data_interpolate(ctx, vertex, tls->vert_interpolation, u, v);
+      }
+      subdiv_mesh_tag_center_vert(coarse_face, vertex, u, v, ctx);
+      subdiv_vert_orco_evaluate(ctx, ptex_face_index, u, v, vertex);
+    }
+  }
+  return true;
+}
+
 /** \} */

