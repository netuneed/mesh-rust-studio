diff --git a/source/blender/blenkernel/intern/subdiv_mesh.cc b/source/blender/blenkernel/intern/subdiv_mesh.cc
index efb86a7..71f90dc 100644
--- a/source/blender/blenkernel/intern/subdiv_mesh.cc
