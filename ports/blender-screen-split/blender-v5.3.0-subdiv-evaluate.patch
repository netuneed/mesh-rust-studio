diff --git a/intern/opensubdiv/internal/evaluator/eval_output_cpu.cc b/intern/opensubdiv/internal/evaluator/eval_output_cpu.cc
index 71b8a92..6eac9bc 100644
--- a/intern/opensubdiv/internal/evaluator/eval_output_cpu.cc
+++ b/intern/opensubdiv/internal/evaluator/eval_output_cpu.cc
@@ -5,5 +5,206 @@
  * Author: Sergey Sharybin. */

+#include "internal/evaluator/eval_output_cpu.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
 namespace blender::opensubdiv {

+using PatchDescriptor = OpenSubdiv::Far::PatchDescriptor;
+
+static bool trace_position_evaluation()
+{
+  static const bool enabled = std::getenv("BLENDER_RUST_SUBDIV_EVAL_TRACE") != nullptr;
+  return enabled;
+}
+
+CpuEvalOutput::~CpuEvalOutput()
+{
+  if (trace_position_evaluation()) {
+    const CpuPatchTable *table = this->getPatchTable();
+    for (int type = 0; type < num_descriptor_types; type++) {
+      const int64_t count = position_samples_[type].load(std::memory_order_relaxed);
+      if (count != 0) {
+        std::fprintf(stderr,
+                     "RUST_SUBDIV_EVAL_POSITION type=%d samples=%lld rust=%lld\n",
+                     type,
+                     (long long)count,
+                     (long long)rust_samples_[type].load(std::memory_order_relaxed));
+      }
+    }
+    for (int channel = 0; channel < table->GetNumFVarChannels(); channel++) {
+      if (table->GetNumPatchArrays() == 0 || table->GetFVarPatchParamSize(channel) == 0) {
+        continue;
+      }
+      const auto *params = table->GetFVarPatchParamBuffer(channel);
+      const auto *arrays = table->GetFVarPatchArrayBuffer(channel);
+      std::array<int64_t, num_descriptor_types> counts = {};
+      for (size_t array = 0; array < table->GetNumPatchArrays(); array++) {
+        for (int patch = 0; patch < arrays[array].GetNumPatches(); patch++) {
+          const int index = arrays[array].GetPrimitiveIdBase() + patch;
+          const int type = params[index].IsRegular() ? arrays[array].GetPatchTypeRegular() :
+                                                       arrays[array].GetPatchTypeIrregular();
+          if (type >= 0 && type < num_descriptor_types) {
+            counts[type]++;
+          }
+        }
+      }
+      for (int type = 0; type < num_descriptor_types; type++) {
+        if (counts[type] != 0) {
+          std::fprintf(stderr,
+                       "RUST_SUBDIV_EVAL_UV_TABLE channel=%d type=%d patches=%lld\n",
+                       channel,
+                       type,
+                       (long long)counts[type]);
+        }
+      }
+    }
+  }
+}
+
+#ifdef WITH_BLENDER_RUST_SUBDIV_EVAL
+struct RustSubdivPositionPatch {
+  float control[16][3];
+  float scale, offset_u, offset_v;
+  uint32_t kind;
+};
+
+static_assert(sizeof(RustSubdivPositionPatch) == 208 && alignof(RustSubdivPositionPatch) == 4);
+static_assert(offsetof(RustSubdivPositionPatch, control) == 0);
+static_assert(offsetof(RustSubdivPositionPatch, scale) == 192);
+static_assert(offsetof(RustSubdivPositionPatch, offset_u) == 196);
+static_assert(offsetof(RustSubdivPositionPatch, offset_v) == 200);
+static_assert(offsetof(RustSubdivPositionPatch, kind) == 204);
+
+extern "C" uint8_t blender_rust_subdiv_position_batch(RustSubdivPositionPatch patch,
+                                                      const float (*uv)[2],
+                                                      size_t count,
+                                                      float *positions);
+
+static bool evaluate_rust_position_batch(const CpuPatchTable &table,
+                                         CpuVertexBuffer &vertices,
+                                         const OpenSubdiv::Osd::PatchArray &array,
+                                         const OpenSubdiv::Osd::PatchParam &param,
+                                         const int type,
+                                         const PatchCoord *coords,
+                                         const int count,
+                                         float *positions)
+{
+  const int controls = type == PatchDescriptor::QUADS ? 4 : 16;
+  if (count < 2 || count > 128 || vertices.GetNumElements() != 3 ||
+      (type != PatchDescriptor::QUADS &&
+       (type != PatchDescriptor::REGULAR || param.GetBoundary() != 0 || param.sharpness != 0.0f)))
+  {
+    return false;
+  }
+  const int relative_index = coords[0].handle.patchIndex - array.GetPrimitiveIdBase();
+  if (relative_index < 0 || relative_index >= array.GetNumPatches() ||
+      array.GetStride() < controls || array.GetIndexBase() < 0)
+  {
+    return false;
+  }
+  const size_t start = size_t(array.GetIndexBase()) + size_t(array.GetStride()) * relative_index;
+  const size_t index_count = table.GetPatchIndexSize();
+  if (start >= index_count || size_t(controls) > index_count - start ||
+      param.GetDepth() < int(param.NonQuadRoot()))
+  {
+    return false;
+  }
+  const int *indices = table.GetPatchIndexBuffer() + start;
+  const float *source = vertices.BindCpuBuffer();
+  const int source_count = vertices.GetNumVertices();
+  RustSubdivPositionPatch patch = {};
+  patch.scale = 1.0f / param.GetParamFraction();
+  patch.offset_u = float(param.GetU());
+  patch.offset_v = float(param.GetV());
+  patch.kind = type == PatchDescriptor::QUADS ? 0 : 1;
+  for (int index = 0; index < controls; index++) {
+    const int vertex = indices[index];
+    if (vertex < 0 || vertex >= source_count) {
+      return false;
+    }
+    std::copy_n(source + size_t(vertex) * 3, 3, patch.control[index]);
+  }
+  float uv[128][2];
+  for (int index = 0; index < count; index++) {
+    uv[index][0] = coords[index].s;
+    uv[index][1] = coords[index].t;
+  }
+  return blender_rust_subdiv_position_batch(patch, uv, size_t(count), positions) == 1;
+}
+#endif
+
+void CpuEvalOutput::evalPatches(const PatchCoord *coords, const int count, float *positions)
+{
+  using StockEvaluator = VolatileEvalOutput<CpuVertexBuffer,
+                                            CpuVertexBuffer,
+                                            StencilTable,
+                                            CpuPatchTable,
+                                            CpuEvaluator>;
+  const bool trace = trace_position_evaluation();
+#ifdef WITH_BLENDER_RUST_SUBDIV_EVAL
+  static const bool use_rust = std::getenv("BLENDER_RUST_SUBDIV_EVAL_CPP") == nullptr &&
+                               std::getenv("BLENDER_RUST_SUBDIV_CPP") == nullptr;
+#else
+  constexpr bool use_rust = false;
+#endif
+  if (count <= 1 || (!use_rust && !trace)) {
+    StockEvaluator::evalPatches(coords, count, positions);
+    return;
+  }
+
+  const CpuPatchTable &table = *this->getPatchTable();
+  if (table.GetNumPatchArrays() == 0 || table.GetPatchParamSize() == 0) {
+    StockEvaluator::evalPatches(coords, count, positions);
+    return;
+  }
+  const auto *arrays = table.GetPatchArrayBuffer();
+  const auto *params = table.GetPatchParamBuffer();
+  for (int first = 0; first < count;) {
+    const auto handle = coords[first].handle;
+    int last = first + 1;
+    while (last < count && coords[last].handle.arrayIndex == handle.arrayIndex &&
+           coords[last].handle.patchIndex == handle.patchIndex)
+    {
+      last++;
+    }
+    if (handle.arrayIndex < 0 || size_t(handle.arrayIndex) >= table.GetNumPatchArrays() ||
+        handle.patchIndex < 0 || size_t(handle.patchIndex) >= table.GetPatchParamSize())
+    {
+      StockEvaluator::evalPatches(coords + first, last - first, positions + 3 * first);
+      first = last;
+      continue;
+    }
+    const auto &array = arrays[handle.arrayIndex];
+    const auto &param = params[handle.patchIndex];
+    const int type = param.IsRegular() ? array.GetPatchTypeRegular() :
+                                         array.GetPatchTypeIrregular();
+    bool processed = false;
+#ifdef WITH_BLENDER_RUST_SUBDIV_EVAL
+    processed = use_rust && evaluate_rust_position_batch(table,
+                                                         *this->getSrcBuffer(),
+                                                         array,
+                                                         param,
+                                                         type,
+                                                         coords + first,
+                                                         last - first,
+                                                         positions + 3 * first);
+#endif
+    if (!processed) {
+      StockEvaluator::evalPatches(coords + first, last - first, positions + 3 * first);
+    }
+    if (trace && type >= 0 && type < num_descriptor_types) {
+      position_samples_[type].fetch_add(last - first, std::memory_order_relaxed);
+      if (processed) {
+        rust_samples_[type].fetch_add(last - first, std::memory_order_relaxed);
+      }
+    }
+    first = last;
+  }
+}
+
 }  // namespace blender::opensubdiv
