+{
+  constexpr int batch_size = 128;
+  for (int64_t begin = 0; begin < positions.size(); begin += batch_size) {
+    const int count = int(std::min<int64_t>(batch_size, positions.size() - begin));
+#ifdef WITH_OPENSUBDIV
+    OpenSubdiv_PatchCoord coordinates[batch_size];
+    for (int index = 0; index < count; index++) {
