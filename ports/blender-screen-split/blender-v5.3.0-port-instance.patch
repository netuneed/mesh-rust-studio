+static const char *port_runtime_directory(const char *name, const size_t capacity)
+{
+  const char *directory = BLI_getenv(name);
+  if (directory && BLI_path_is_abs_from_cwd(directory) && strlen(directory) + 2 <= capacity &&
+      BLI_is_dir(directory))
+  {
+    return directory;
+  }
+  return nullptr;
+}
