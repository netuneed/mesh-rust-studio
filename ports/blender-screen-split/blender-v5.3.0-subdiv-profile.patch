+static void subdivision_bmesh_fingerprint(BMEditMesh *em, BMesh *bm)
+{
+  static const bool verify = [] {
+    const char *value = std::getenv("BLENDER_SUBDIVISION_BMESH_HASH");
+    return value && value[0] == '1' && value[1] == '\0';
+  }();
+  if (!verify || (bm->elem_index_dirty & (BM_VERT | BM_EDGE | BM_FACE | BM_LOOP))) {
+    return;
+  }
+
+  struct Fingerprint {
+    uint64_t value = 14695981039346656037ULL;
+    void add(const uint32_t data)
+    {
+      value = (value ^ data) * 1099511628211ULL;
+    }
+    void add_index(const BMElem *element)
+    {
+      this->add(element ? uint32_t(BM_elem_index_get(element)) : UINT32_MAX);
+    }
+    void add_floats(const float *data, const int count)
+    {
+      for (int i = 0; i < count; ++i) {
+        this->add(std::bit_cast<uint32_t>(data[i]));
+      }
+    }
+  } vertices, edges, faces, loops, normals, triangles, uv;
+
+  const int uv_layer = CustomData_get_offset(&bm->ldata, CD_PROP_FLOAT2);
+  const int face_loop_limit = bm->totloop;
+  int seen_loops = 0;
+  BMIter iter;
+  BMVert *vert;
+  BM_ITER_MESH (vert, &iter, bm, BM_VERTS_OF_MESH) {
+    vertices.add_floats(vert->co, 3);
+    vertices.add(vert->head.hflag);
+    vertices.add_index(reinterpret_cast<const BMElem *>(vert->e));
+    normals.add_floats(vert->no, 3);
+  }
+  BMEdge *edge;
+  BM_ITER_MESH (edge, &iter, bm, BM_EDGES_OF_MESH) {
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v1));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v2));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->l));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v1_disk_link.next));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v1_disk_link.prev));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v2_disk_link.next));
+    edges.add_index(reinterpret_cast<const BMElem *>(edge->v2_disk_link.prev));
+    edges.add(edge->head.hflag);
+  }
+  BMFace *face;
+  BM_ITER_MESH (face, &iter, bm, BM_FACES_OF_MESH) {
+    faces.add(face->len);
+    faces.add(face->mat_nr);
+    faces.add(face->head.hflag);
+    normals.add_floats(face->no, 3);
+    const BMLoop *first = BM_FACE_FIRST_LOOP(face);
+    const BMLoop *loop = first;
+    for (int i = 0; i < face->len; ++i, loop = loop->next) {
+      if (loop == nullptr || ++seen_loops > face_loop_limit || (i > 0 && loop == first)) {
+        std::fprintf(stderr, "SUBDIV_BMESH_HASH_ERROR invalid face loop cycle\n");
+        return;
+      }
+      loops.add_index(reinterpret_cast<const BMElem *>(loop));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->v));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->e));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->next));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->prev));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->radial_next));
+      loops.add_index(reinterpret_cast<const BMElem *>(loop->radial_prev));
+      loops.add(loop->head.hflag);
+      if (uv_layer >= 0) {
+        uv.add_floats(*BM_ELEM_CD_GET_FLOAT2_P(loop, uv_layer), 2);
+      }
+    }
+    if (loop != first) {
+      std::fprintf(stderr, "SUBDIV_BMESH_HASH_ERROR unterminated face loop cycle\n");
+      return;
+    }
+  }
+  if (seen_loops != face_loop_limit) {
+    std::fprintf(stderr, "SUBDIV_BMESH_HASH_ERROR unexpected face loop count\n");
+    return;
+  }
+  for (const auto &triangle : em->looptris) {
+    for (const BMLoop *loop : triangle) {
+      triangles.add_index(reinterpret_cast<const BMElem *>(loop));
+    }
+  }
+  std::fprintf(stderr,
+               "SUBDIV_BMESH_HASH counts=%d,%d,%d,%d tris=%" PRId64
+               " vertices=%016" PRIx64 " edges=%016" PRIx64 " faces=%016" PRIx64
+               " loops=%016" PRIx64 " normals=%016" PRIx64 " looptris=%016" PRIx64
+               " uv=%016" PRIx64 "\n",
+               bm->totvert,
+               bm->totedge,
+               bm->totface,
+               bm->totloop,
+               int64_t(em->looptris.size()),
+               vertices.value,
+               edges.value,
+               faces.value,
+               loops.value,
+               normals.value,
+               triangles.value,
+               uv.value);
+}
+
 void BKE_editmesh_looptris_and_normals_calc(BMEditMesh *em, BMesh *bm)
 {
+  const auto profile_tris = subdivision_profile::start();
   BMeshCalcTessellation_Params looptris_params{};
   looptris_params.face_normals = true;
   BKE_editmesh_looptris_calc_ex(em, bm, &looptris_params);
+  subdivision_profile::report("edit_looptris_with_face_normals", profile_tris);
+  const auto profile_normals = subdivision_profile::start();
   BMeshNormalsUpdate_Params normals_params{};
   normals_params.face_normals = false;
   BM_mesh_normals_update_ex(bm, &normals_params);
+  subdivision_profile::report("edit_vertex_normals", profile_normals);
+  subdivision_bmesh_fingerprint(em, bm);
 }

