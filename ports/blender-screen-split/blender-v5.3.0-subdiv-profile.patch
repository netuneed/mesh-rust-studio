+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+
+namespace blender::subdivision_profile {
+
+/* Test-only diagnostics. Production and timing runs leave this off. */
+inline bool enabled()
+{
+  static const bool value = [] {
+    const char *env = std::getenv("BLENDER_SUBDIVISION_PROFILE");
+    return env && env[0] == '1' && env[1] == '\0';
+  }();
+  return value;
+}
+
+using Clock = std::chrono::steady_clock;
+using Point = Clock::time_point;
+
+inline Point start()
+{
+  return enabled() ? Clock::now() : Point{};
+}
+
+inline double elapsed(const Point begin)
+{
+  return std::chrono::duration<double, std::milli>(Clock::now() - begin).count();
+}
+
+inline void report(const char *phase, const Point begin)
+{
+  if (enabled()) {
+    std::fprintf(stderr, "SUBDIV_PHASE name=%s ms=%.6f\n", phase, elapsed(begin));
+  }
+}
+
+}  // namespace blender::subdivision_profile
