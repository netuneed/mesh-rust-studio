+
+static ExactTopology topology_from_imesh(meshintersect::IMesh &im)
+{
+  im.populate_vert();
+  ExactTopology out;
+  out.positions.reinitialize(im.vert_size());
+  out.vertex_orig.reinitialize(im.vert_size());
+  threading::parallel_for(im.vert_index_range(), 4096, [&](const IndexRange range) {
+    for (const int vert : range) {
+      const meshintersect::Vert *v = im.vert(vert);
+      copy_v3fl_v3db(out.positions[vert], v->co);
+      out.vertex_orig[vert] = v->orig;
+    }
+  });
+
+  out.face_offsets.reinitialize(im.face_size() + 1);
+  out.face_orig.reinitialize(im.face_size());
+  threading::parallel_for(im.face_index_range(), 4096, [&](const IndexRange range) {
+    for (const int face : range) {
+      out.face_offsets[face] = im.face(face)->size();
+      out.face_orig[face] = im.face(face)->orig;
+    }
+  });
+  const OffsetIndices faces = offset_indices::accumulate_counts_to_offsets(out.face_offsets);
+  out.corner_verts.reinitialize(faces.total_size());
+  out.corner_edge_orig.reinitialize(faces.total_size());
+  out.corner_intersects.reinitialize(faces.total_size());
+  threading::parallel_for(im.face_index_range(), 4096, [&](const IndexRange range) {
+    for (const int face : range) {
+      const meshintersect::Face &f = *im.face(face);
+      for (const int i : f.index_range()) {
+        const int corner = faces[face][i];
+        out.corner_verts[corner] = im.lookup_vert(f.vert[i]);
+        out.corner_edge_orig[corner] = f.edge_orig[i];
+        out.corner_intersects[corner] = f.is_intersect[i];
+      }
+    }
+  });
+  return out;
+}
