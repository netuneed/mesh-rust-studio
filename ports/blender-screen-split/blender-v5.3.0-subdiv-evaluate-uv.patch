+void eval_face_varying_grid_row(Subdiv *subdiv,
+                                const int channel,
+                                const int ptex_face_index,
+                                const float step,
+                                const float v,
+                                const MutableSpan<float2> output)
+{
+#ifdef WITH_OPENSUBDIV
+  static const bool use_scalar = std::getenv("BLENDER_SUBDIV_UV_EVAL_SCALAR") != nullptr;
+  if (!use_scalar && subdiv->evaluator->type == OPENSUBDIV_EVALUATOR_CPU) {
+    constexpr int batch_size = 128;
+    for (int64_t begin = 0; begin < output.size(); begin += batch_size) {
+      const int count = int(std::min<int64_t>(batch_size, output.size() - begin));
+      OpenSubdiv_PatchCoord coordinates[batch_size];
+      for (int index = 0; index < count; index++) {
+        coordinates[index] = {ptex_face_index, float(begin + index + 1) * step, v};
+      }
+      subdiv->evaluator->eval_output->evaluatePatchesFaceVarying(
+          channel, coordinates, count, output[begin]);
+    }
+    return;
+  }
+#endif
+  for (const int x : output.index_range()) {
+    eval_face_varying(subdiv, channel, ptex_face_index, float(x + 1) * step, v, output[x]);
+  }
+}
