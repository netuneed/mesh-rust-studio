 }

+#ifdef WITH_BLENDER_RUST_CURVE_RING
+constexpr int rust_curve_ring_size = 10;
+
+/* Keep these value types in sync with ports/blender-screen-split/curve_ring.rs. */
+struct RustCurveRingMatrix {
+  float columns[4][3];
+};
+
+struct RustCurveRingPoints {
+  float points[rust_curve_ring_size][3];
+};
+
+static_assert(sizeof(RustCurveRingMatrix) == 48 && alignof(RustCurveRingMatrix) == 4);
+static_assert(sizeof(RustCurveRingPoints) == 120 && alignof(RustCurveRingPoints) == 4);
+static_assert(offsetof(RustCurveRingMatrix, columns) == 0);
+static_assert(offsetof(RustCurveRingPoints, points) == 0);
+
+extern "C" RustCurveRingPoints blender_rust_curve_ring(RustCurveRingMatrix matrix,
+                                                       RustCurveRingPoints profile,
+                                                       uint32_t trace_rings);
+#endif
+
 static void fill_mesh_positions(const Span<float3> main_positions,
                                 const Span<float3> profile_positions,
                                 const Span<float3> tangents,
@@ -261,8 +285,45 @@ static void fill_mesh_positions(const Span<float3> main_positions,
                                 const Span<float> scales,
                                 const bool main_cyclic,
                                 const std::optional<float> miter_scale_limit,
-                                MutableSpan<float3> mesh_positions)
+                                MutableSpan<float3> mesh_positions,
+                                [[maybe_unused]] const bool profile_cyclic)
 {
+#ifdef WITH_BLENDER_RUST_CURVE_RING
+  if (profile_positions.size() == rust_curve_ring_size && profile_cyclic && !main_cyclic &&
+      scales.is_empty() && !miter_scale_limit && main_positions.size() > 0 &&
+      main_positions.size() <= 1024)
+  {
+    RustCurveRingPoints profile;
+    bool planar = true;
+    for (const int p : IndexRange(rust_curve_ring_size)) {
+      for (const int i : IndexRange(3)) {
+        profile.points[p][i] = profile_positions[p][i];
+      }
+      planar &= profile.points[p][2] == 0.0f;
+    }
+
+    if (planar) {
+      for (const int i_ring : main_positions.index_range()) {
+        const float4x4 point_matrix = build_point_matrix(
+            main_positions, tangents, normals, scales, main_cyclic, miter_scale_limit, i_ring);
+        RustCurveRingMatrix matrix;
+        for (const int c : IndexRange(4)) {
+          for (const int i : IndexRange(3)) {
+            matrix.columns[c][i] = point_matrix[c][i];
+          }
+        }
+        const uint32_t trace = i_ring == 0 ? uint32_t(main_positions.size()) : 0;
+        const RustCurveRingPoints positions = blender_rust_curve_ring(matrix, profile, trace);
+        const int ring_start = i_ring * rust_curve_ring_size;
+        for (const int p : IndexRange(rust_curve_ring_size)) {
+          const float *co = positions.points[p];
+          mesh_positions[ring_start + p] = float3(co[0], co[1], co[2]);
+        }
+      }
+      return;
+    }
+  }
