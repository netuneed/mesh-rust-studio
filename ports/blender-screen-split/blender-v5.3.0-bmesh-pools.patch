+#ifdef BLI_MEMPOOL_BULK_INIT
+static bool mempool_initialize_detached_chunk(const BLI_mempool *pool,
+                                              BLI_mempool_chunk *chunk,
+                                              const BLI_mempool_chunk_init init)
+{
+  static_assert(sizeof(BLI_freenode) == 2 * sizeof(void *));
+  static_assert(alignof(BLI_freenode) == alignof(void *));
+  static_assert(offsetof(BLI_freenode, next) == 0);
+  static_assert(offsetof(BLI_freenode, freeword) == sizeof(void *));
+  BLI_freenode *node = CHUNK_DATA(chunk);
+  const uint esize = pool->esize;
+  const uint iter = (pool->flag & BLI_MEMPOOL_ALLOW_ITER) ? 1 : 0;
+  if (init && init(node, pool->pchunk, esize, iter, FREEWORD)) {
+    return true;
+  }
+
+  if (iter) {
+    for (uint i = 0; i < pool->pchunk; i++) {
+      node->freeword = FREEWORD;
+      node->next = i + 1 == pool->pchunk ? nullptr : NODE_STEP_NEXT(node);
+      node = NODE_STEP_NEXT(node);
+    }
+  }
+  else {
+    for (uint i = 0; i < pool->pchunk; i++) {
+      node->next = i + 1 == pool->pchunk ? nullptr : NODE_STEP_NEXT(node);
+      node = NODE_STEP_NEXT(node);
+    }
+  }
+  return false;
+}
+
+static void mempool_init_bulk(BLI_mempool *pool, const BLI_mempool_chunk_init init)
+{
+  /* Keep guarded allocations and list assembly in the same order as stock creation. The
+   * tasks only touch the detached chunks before publication. Bound the scratch table. */
+  constexpr uint batch_size = 512;
+  BLI_mempool_chunk *chunks[batch_size];
+  bool initialized_in_rust[batch_size];
+  const char *trace_value = std::getenv("BLENDER_RUST_BMESH_POOL_TRACE");
+  const bool trace = trace_value && trace_value[0] == '1' && trace_value[1] == '\0';
+  uint rust_chunks = 0;
+  BLI_freenode *last_tail = nullptr;
+  const uint esize = pool->esize;
+  for (uint done = 0; done < pool->maxchunks;) {
+    const uint count = std::min(batch_size, pool->maxchunks - done);
+    for (uint i = 0; i < count; i++) {
+      chunks[i] = mempool_chunk_alloc(pool);
+    }
+    threading::parallel_for(IndexRange(count), 16, [&](const IndexRange range) {
+      for (const int64_t i : range) {
+        initialized_in_rust[i] = mempool_initialize_detached_chunk(pool, chunks[i], init);
+      }
+    });
+    for (uint i = 0; i < count; i++) {
+      BLI_mempool_chunk *chunk = chunks[i];
+      BLI_freenode *first = CHUNK_DATA(chunk);
+      if (pool->chunk_tail) {
+        pool->chunk_tail->next = chunk;
+        last_tail->next = first;
+      }
+      else {
+        pool->chunks = chunk;
+        pool->free = first;
+      }
+      chunk->next = nullptr;
+      pool->chunk_tail = chunk;
+      last_tail = reinterpret_cast<BLI_freenode *>(
+          reinterpret_cast<char *>(first) + (pool->pchunk - 1) * esize);
+      rust_chunks += initialized_in_rust[i];
+    }
+    done += count;
+  }
+  if (trace) {
+    std::fprintf(stderr,
+                 "RUST_BMESH_POOL chunks=%u rust_chunks=%u slots_per_chunk=%u stride=%u\n",
+                 pool->maxchunks,
+                 rust_chunks,
+                 pool->pchunk,
+                 esize);
+  }
+}
+#endif
