+    for (uint i = 0; i < maxchunks; i++) {
       BLI_mempool_chunk *mpchunk = mempool_chunk_alloc(pool);
       last_tail = mempool_chunk_add(pool, mpchunk, last_tail);
@@ -384,4 +491,17 @@
