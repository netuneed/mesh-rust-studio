+                                                         int32_t *offsets,
+                                                         size_t face_count,
+                                                         int32_t *triangles);
+
+struct PackedFaceGroups {
+  Array<int> offsets;
+  Array<int> triangles;
+
+  int64_t size() const
+  {
+    return offsets.size() - 1;
+  }
+
+  IndexRange index_range() const
+  {
+    return IndexRange(this->size());
+  }
+
+  Span<int> operator[](const int index) const
+  {
+    return triangles.as_span().slice(offsets[index], offsets[index + 1] - offsets[index]);
+  }
+};
+
+static PackedFaceGroups get_face_groups(const MeshGL &mgl, const int input_faces_num)
+{
+#    ifdef DEBUG_TIME
+  timeit::ScopedTimer timer("get_face_groups (Rust)");
+#    endif
+  const int tris_num = mgl.NumTri();
+  BLI_assert(mgl.faceID.size() == tris_num);
+  PackedFaceGroups groups{Array<int>(int64_t(input_faces_num) + 1, 0), Array<int>(tris_num, 0)};
+  if (!blender_rust_boolean_group_triangles(
+          mgl.faceID.data(), tris_num, groups.offsets.data(), input_faces_num, groups.triangles.data()))
+  {
+    throw std::runtime_error("Invalid face IDs in the Manifold Boolean result");
+  }
+  return groups;
+}
